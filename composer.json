{
    "name": "amashukov/blockchain-address-php",
    "description": "Typed on-chain address value objects for EVM, TON and Lightning — ChainAddressInterface, TonAddress, EvmAddress, Erc20Address, JettonAddress, Bolt11Invoice with structural eq() comparison.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AndreyMashukov/blockchain-address-php",
    "keywords": [
        "blockchain",
        "address",
        "value-object",
        "evm",
        "ethereum",
        "ton",
        "the-open-network",
        "lightning",
        "bolt11",
        "erc20",
        "jetton",
        "php"
    ],
    "support": {
        "issues": "https://github.com/AndreyMashukov/blockchain-address-php/issues",
        "source": "https://github.com/AndreyMashukov/blockchain-address-php"
    },
    "authors": [
        {
            "name": "Andrei Mashukov",
            "email": "a.mashukoff@gmail.com",
            "homepage": "https://github.com/AndreyMashukov"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "amashukov/ton-wallet-php": "^0.1.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "amashukov/rector-php-rules": "^0.4",
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Amashukov\\BlockchainAddress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amashukov\\BlockchainAddress\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run"
    }
}
